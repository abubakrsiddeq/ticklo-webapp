# ---------------------------------------------------------------------------
# TickLO web – environment variables
# Copy to web/.env.local for local development. On Hostinger, set these in
# the Node.js app settings. NEVER commit real values.
# ---------------------------------------------------------------------------

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Email: SMTP is used when SMTP_HOST is set, else Resend, else console.
# Hostinger mail: host smtp.hostinger.com, port 465 (TLS/SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
RESEND_API_KEY=
# Sender address – with SMTP it must be the SMTP_USER mailbox
EMAIL_FROM="TickLO <noreply@example.com>"
# Optional: a real inbox for replies (helps deliverability and support)
EMAIL_REPLY_TO=
# Signs ticket QR codes – SAME value as the Supabase Edge Function secret
# QR_SIGNING_SECRET (supabase secrets set QR_SIGNING_SECRET=...)
QR_SIGNING_SECRET=change-me-to-a-long-random-string
# Shared secret for /api/cron/* endpoints (Hostinger cron jobs send it)
CRON_SECRET=change-me-to-a-long-random-string
